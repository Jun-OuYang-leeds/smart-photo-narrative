# Smart Photo Narrative — example environment file.
# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your REAL values to the right of each
# "=" (no spaces around "="). ".env" is git-ignored and is never committed.
# This file (".env.example") contains PLACEHOLDERS ONLY — never put a real key
# here. Restart `streamlit run app.py` after editing.
#
# Accepted value forms:
#   DASHSCOPE_API_KEY=sk-abcdef123
#   DASHSCOPE_API_KEY="sk-abcdef123"
#   DASHSCOPE_API_KEY=sk-abcdef123   # my work key
#
# SECRET DISCIPLINE: API keys live ONLY in .env. Never paste them into code,
# issues, logs, or experiment result files. The eval scripts print only a masked
# key hint (first/last few characters), never the full key.

# ==================== Production Story backend (unchanged) ====================
# Required ONLY if you use the "Remote API (DashScope)" backend in the Story page.
# The local Ollama backend does not need this. Production Story keeps using
# qwen3.5-27b regardless of the EVAL block below.
# Get a key: https://bailian.console.aliyun.com/  ->  Api-Key Management
DASHSCOPE_API_KEY=sk-replace-me

# Optional: override the production remote endpoint / model. Replace {WorkspaceId}
# with your real workspace id. EU region example:
# SMART_PHOTO_REMOTE_BASE_URL=https://{WorkspaceId}.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
# SMART_PHOTO_REMOTE_MODEL=qwen3.5-27b

# ==================== Experimental Eval LLM (Qwen3.7) ====================
# A SECOND, independent remote LLM used ONLY by the new dissertation retrieval
# experiment (R0--R7) and the single-event Story case study. It does NOT replace
# the production Story backend above.
#
# Region discipline:
#   * Choose ONE active region manually: beijing or frankfurt.
#   * The active region must pair its OWN base_url with its OWN api_key. There
#     is NO automatic cross-region failover; only the active region's pair is
#     read. Region keys must NOT be crossed (a Beijing key will not work against
#     the Frankfurt endpoint and vice versa).
#   * Once the formal experiment starts, run:
#       python scripts/eval_lock_region.py freeze
#     to freeze the region+model. A later run in a different region is refused.
#   * Endpoint formats (replace {WorkspaceId}):
#       Beijing   -> https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#       Frankfurt -> https://{WorkspaceId}.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
SMART_PHOTO_EVAL_ACTIVE_REGION=beijing
SMART_PHOTO_EVAL_MODEL=qwen3.7-plus-2026-05-26
SMART_PHOTO_EVAL_TIMEOUT=180

# Beijing (cn-beijing) region pair.
SMART_PHOTO_EVAL_BEIJING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SMART_PHOTO_EVAL_BEIJING_API_KEY=sk-replace-beijing

# Frankfurt (eu-central-1) region pair. Used only if you manually switch
# SMART_PHOTO_EVAL_ACTIVE_REGION=frankfurt after the Beijing speed test is
# unsatisfactory, then re-run the speed test and freeze the German config.
SMART_PHOTO_EVAL_FRANKFURT_BASE_URL=https://{WorkspaceId}.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
SMART_PHOTO_EVAL_FRANKFURT_API_KEY=sk-replace-frankfurt
